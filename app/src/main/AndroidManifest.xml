<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for discreet background recording and key feedback -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".StealthApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Core Main Activity (Target of all launcher aliases) -->
        <activity
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication" />

        <!-- Disguise 0: Default Stealth Voice Alias (Initially Enabled) -->
        <activity-alias
            android:name=".DefaultAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Disguise 1: Calculator Alias -->
        <activity-alias
            android:name=".CalculatorAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_calc_launcher"
            android:roundIcon="@mipmap/ic_calc_launcher_round"
            android:label="@string/alias_calc_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Disguise 2: Notes Alias -->
        <activity-alias
            android:name=".NotesAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_notes_launcher"
            android:roundIcon="@mipmap/ic_notes_launcher_round"
            android:label="@string/alias_notes_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Disguise 3: Clock Alias -->
        <activity-alias
            android:name=".ClockAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_clock_launcher"
            android:roundIcon="@mipmap/ic_clock_launcher_round"
            android:label="@string/alias_clock_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Background Microphone Service for Secret Recording -->
        <service
            android:name=".service.StealthRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Accessibility Service to detect double Volume Up (Start) & double Volume Down (Stop) even when locked -->
        <service
            android:name=".service.VolumeKeyAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/volume_key_service_config" />
        </service>

        <!-- Secure FileProvider for encrypted audio export -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
